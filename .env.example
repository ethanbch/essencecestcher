# Production (Vercel) uniquement — en local, rien n'est nécessaire (stockage dans ./data).

# Créé automatiquement quand on connecte un store Vercel Blob au projet.
BLOB_READ_WRITE_TOKEN=

# Secret envoyé par Vercel Cron au job du matin (chaîne aléatoire de 16+ caractères).
CRON_SECRET=

# URL publique (canonique, sitemap, partage). Sur Vercel, déduite automatiquement si absente.
NEXT_PUBLIC_SITE_URL=

# Mentions légales (facultatif). Sans nom : édition non professionnelle anonyme (LCEN art. 6, III-2).
NEXT_PUBLIC_EDITOR_NAME=
# Contact public. Sans e-mail : lien vers les tickets GitHub du dépôt.
NEXT_PUBLIC_CONTACT_EMAIL=
